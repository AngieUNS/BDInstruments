---
import { site, whatsappHref } from '../data/site';

const path = Astro.url.pathname;

const links = [
  { href: '/', label: 'Inicio' },
  { href: '/productos', label: 'Productos' },
  { href: '/servicios', label: 'Servicios' },
  { href: '/proyectos', label: 'Proyectos' },
  { href: '/industrias', label: 'Industrias' },
  { href: '/nosotros', label: 'Nosotros' },
  { href: '/contacto', label: 'Contacto' },
];

function isCurrent(href: string) {
  const currentPath = path.replace(/\/+$/, '') || '/';

  if (href === '/') return currentPath === '/';

  return currentPath === href || currentPath.startsWith(`${href}/`);
}
---

<header class="header" data-header>
  <div class="header-container">
    <a class="logo" href="/" aria-label="BD Instruments - Inicio">
      <img
        class="logo-img"
        src="https://bdinstruments.com/wp-content/uploads/2024/08/BD-instruments-logotipo-1.png"
        alt="BD Instruments"
        height="48"
      />
    </a>

    <nav class="nav" id="navegacion" data-nav aria-label="Navegación principal">
      <div class="nav-links">
        {
          links.map((link) => (
            <a
              href={link.href}
              class:list={['nav-link', { 'is-active': isCurrent(link.href) }]}
              aria-current={isCurrent(link.href) ? 'page' : undefined}
            >
              <span>{link.label}</span>
              <svg class="nav-chevron" viewBox="0 0 24 24" aria-hidden="true">
                <path d="m9 6 6 6-6 6" />
              </svg>
            </a>
          ))
        }
      </div>

      <!-- Solo visible en el menú móvil -->
      <div class="nav-extra">
        <a class="nav-cta" href="/contacto">
          Solicitar cotización
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
        </a>

        <div class="nav-contact">
          <a href={whatsappHref()} target="_blank" rel="noopener noreferrer">
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="M21 11.5a8.4 8.4 0 0 1-12.4 7.4L3 20.5l1.6-5.4A8.4 8.4 0 1 1 21 11.5Z" />
            </svg>
            <span><small>WhatsApp</small>{site.whatsappDisplay}</span>
          </a>
          <a href={`tel:${site.phoneTel}`}>
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 1.9.7 2.8a2 2 0 0 1-.5 2.1L8 9.9a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.8.7a2 2 0 0 1 1.7 2Z" />
            </svg>
            <span><small>Teléfono</small>{site.phoneDisplay}</span>
          </a>
        </div>

        <p class="nav-hours">{site.hours}</p>
      </div>
    </nav>

    <button
      class="nav-toggle"
      type="button"
      aria-label="Abrir menú"
      aria-expanded="false"
      aria-controls="navegacion"
      data-nav-toggle
    >
      <span class="hamburger" aria-hidden="true">
        <span></span>
        <span></span>
        <span></span>
      </span>
    </button>
  </div>

  <div class="nav-backdrop" data-nav-backdrop aria-hidden="true"></div>
</header>

<style>
  .header {
    --header-h: 84px;

    position: sticky;
    top: 0;
    z-index: 100;
    width: 100%;
    background: rgb(255 255 255 / 96%);
    border-bottom: 1px solid var(--line);
    transition:
      box-shadow 0.25s ease,
      background-color 0.25s ease;
  }

  .header.is-scrolled {
    box-shadow: 0 5px 22px rgb(12 27 51 / 8%);
    background: rgb(255 255 255 / 98%);
  }

  .header-container {
    position: relative;
    z-index: 2;
    width: min(100% - 64px, 1280px);
    min-height: var(--header-h);
    margin-inline: auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 32px;
  }

  /* LOGO */

  .logo {
    display: inline-flex;
    align-items: center;
    flex-shrink: 1;
    min-width: 0;
    color: var(--brand);
    font-family: var(--serif);
    font-weight: 800;
    text-decoration: none;
  }

  .logo-img {
    display: block;
    height: 48px;
    width: auto;
    max-width: 100%;
  }

  /* NAVEGACIÓN ESCRITORIO */

  .nav {
    display: flex;
    align-items: center;
    margin-left: auto;
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: 5px;
  }

  .nav-link {
    position: relative;
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 11px;
    color: var(--muted);
    font-size: 14px;
    font-weight: 600;
    text-decoration: none;
    white-space: nowrap;
    transition:
      color 0.2s ease,
      background-color 0.2s ease;
  }

  .nav-link::after {
    position: absolute;
    right: 11px;
    bottom: 3px;
    left: 11px;
    height: 2px;
    border-radius: 2px;
    background: var(--brand-2);
    content: '';
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.22s ease;
  }

  .nav-link:hover,
  .nav-link.is-active {
    color: var(--brand);
  }

  .nav-link:hover::after,
  .nav-link.is-active::after {
    transform: scaleX(1);
  }

  .nav-chevron,
  .nav-extra,
  .nav-backdrop {
    display: none;
  }

  /* BOTÓN HAMBURGUESA */

  .nav-toggle {
    display: none;
    flex-shrink: 0;
    width: 44px;
    height: 44px;
    padding: 0;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--line);
    border-radius: 10px;
    background: var(--surface);
    color: var(--brand);
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
  }

  .nav-toggle:active {
    background: var(--tint);
  }

  .hamburger {
    position: relative;
    display: block;
    width: 20px;
    height: 14px;
  }

  .hamburger span {
    position: absolute;
    left: 0;
    width: 100%;
    height: 2px;
    border-radius: 2px;
    background: currentColor;
    transition:
      transform 0.25s ease,
      opacity 0.2s ease,
      top 0.25s ease;
  }

  .hamburger span:nth-child(1) { top: 0; }
  .hamburger span:nth-child(2) { top: 6px; }
  .hamburger span:nth-child(3) { top: 12px; }

  .nav-toggle[aria-expanded='true'] .hamburger span:nth-child(1) {
    top: 6px;
    transform: rotate(45deg);
  }

  .nav-toggle[aria-expanded='true'] .hamburger span:nth-child(2) {
    opacity: 0;
  }

  .nav-toggle[aria-expanded='true'] .hamburger span:nth-child(3) {
    top: 6px;
    transform: rotate(-45deg);
  }

  /* LAPTOPS PEQUEÑAS */

  @media (max-width: 1080px) {
    .header-container {
      width: calc(100% - 40px);
      gap: 20px;
    }

    .nav-link {
      padding-inline: 8px;
      font-size: 13px;
    }

    .nav-link::after {
      right: 8px;
      left: 8px;
    }
  }

  /* TABLETS Y CELULARES: MENÚ DESPLEGABLE */

  @media (max-width: 900px) {
    .header {
      --header-h: 68px;
    }

    .header-container {
      gap: 12px;
    }

    .logo-img {
      height: 40px;
    }

    .nav-toggle {
      display: inline-flex;
    }

    .nav {
      position: fixed;
      z-index: 1;
      top: var(--header-h);
      right: 0;
      left: 0;
      display: flex;
      flex-direction: column;
      align-items: stretch;
      gap: 20px;
      max-height: calc(100dvh - var(--header-h));
      margin: 0;
      padding: 12px 20px calc(24px + env(safe-area-inset-bottom));
      overflow-y: auto;
      overscroll-behavior: contain;
      background: var(--surface);
      border-top: 1px solid var(--line);
      border-radius: 0 0 18px 18px;
      box-shadow: 0 18px 40px rgb(12 27 51 / 18%);
      opacity: 0;
      visibility: hidden;
      transform: translateY(-12px);
      transition:
        opacity 0.22s ease,
        transform 0.22s ease,
        visibility 0s linear 0.22s;
    }

    .header.is-open .nav {
      opacity: 1;
      visibility: visible;
      transform: translateY(0);
      transition:
        opacity 0.22s ease,
        transform 0.22s ease,
        visibility 0s;
    }

    .nav-links {
      flex-direction: column;
      align-items: stretch;
      gap: 2px;
    }

    .nav-link {
      justify-content: space-between;
      min-height: 52px;
      padding: 0 14px;
      border-radius: 10px;
      color: var(--ink);
      font-family: var(--serif);
      font-size: 17px;
      font-weight: 700;
    }

    .nav-link::after {
      display: none;
    }

    .nav-link:hover {
      background: var(--bg);
    }

    .nav-link.is-active {
      background: var(--tint);
      color: var(--brand);
    }

    .nav-chevron {
      display: block;
      width: 18px;
      height: 18px;
      fill: none;
      stroke: currentColor;
      stroke-width: 2;
      stroke-linecap: round;
      stroke-linejoin: round;
      opacity: 0.45;
    }

    .nav-link.is-active .nav-chevron {
      opacity: 1;
    }

    /* Bloque inferior: CTA y contacto */

    .nav-extra {
      display: grid;
      gap: 12px;
      padding-top: 16px;
      border-top: 1px solid var(--line);
    }

    .nav-cta {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 10px;
      min-height: 52px;
      border-radius: 10px;
      background: var(--brand);
      color: #fff;
      font-weight: 700;
      text-decoration: none;
    }

    .nav-cta svg,
    .nav-contact svg {
      width: 18px;
      height: 18px;
      flex-shrink: 0;
      fill: none;
      stroke: currentColor;
      stroke-width: 2;
      stroke-linecap: round;
      stroke-linejoin: round;
    }

    .nav-contact {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 10px;
    }

    .nav-contact a {
      display: flex;
      align-items: center;
      gap: 10px;
      min-height: 56px;
      padding: 8px 12px;
      border: 1px solid var(--line);
      border-radius: 10px;
      color: var(--ink);
      font-size: 14px;
      font-weight: 600;
      line-height: 1.25;
      text-decoration: none;
    }

    .nav-contact a:first-child svg {
      color: #128c4a;
    }

    .nav-contact a:last-child svg {
      color: var(--brand);
    }

    .nav-contact small {
      display: block;
      color: var(--muted);
      font-size: 12px;
      font-weight: 500;
    }

    .nav-hours {
      color: var(--muted);
      font-size: 13px;
      text-align: center;
    }

    /* Fondo oscuro detrás del menú */

    .nav-backdrop {
      position: fixed;
      inset: var(--header-h) 0 0;
      z-index: 0;
      display: block;
      background: rgb(12 27 51 / 45%);
      opacity: 0;
      visibility: hidden;
      transition:
        opacity 0.22s ease,
        visibility 0s linear 0.22s;
    }

    .header.is-open .nav-backdrop {
      opacity: 1;
      visibility: visible;
      transition: opacity 0.22s ease;
    }

    .header.is-open {
      background: var(--surface);
    }
  }

  @media (max-width: 420px) {
    .header-container {
      width: calc(100% - 32px);
    }

    .logo-img {
      height: 36px;
    }

    .nav {
      padding-inline: 16px;
    }

    .nav-contact {
      grid-template-columns: 1fr;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .header,
    .nav,
    .nav-link,
    .nav-link::after,
    .nav-backdrop,
    .hamburger span {
      transition: none !important;
    }
  }
</style>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]');
  const toggle = header?.querySelector<HTMLButtonElement>('[data-nav-toggle]');
  const nav = header?.querySelector<HTMLElement>('[data-nav]');
  const backdrop = header?.querySelector<HTMLElement>('[data-nav-backdrop]');

  if (header && toggle && nav) {
    const mobileQuery = window.matchMedia('(max-width: 900px)');

    function isOpen() {
      return toggle!.getAttribute('aria-expanded') === 'true';
    }

    function setOpen(open: boolean) {
      header!.classList.toggle('is-open', open);
      document.body.classList.toggle('nav-open', open);
      toggle!.setAttribute('aria-expanded', String(open));
      toggle!.setAttribute('aria-label', open ? 'Cerrar menú' : 'Abrir menú');

      if (open) {
        nav!.scrollTop = 0;
        nav!.querySelector<HTMLElement>('a')?.focus({ preventScroll: true });
      }
    }

    toggle.addEventListener('click', () => setOpen(!isOpen()));
    backdrop?.addEventListener('click', () => setOpen(false));

    nav.addEventListener('click', (event) => {
      if (event.target instanceof Element && event.target.closest('a')) {
        setOpen(false);
      }
    });

    document.addEventListener('keydown', (event) => {
      if (!isOpen()) return;

      if (event.key === 'Escape') {
        setOpen(false);
        toggle.focus();
        return;
      }

      // Mantiene el foco dentro del menú abierto (botón + enlaces).
      if (event.key === 'Tab') {
        const focusables = [
          toggle,
          ...nav.querySelectorAll<HTMLElement>('a[href]'),
        ];
        const first = focusables[0];
        const last = focusables[focusables.length - 1];

        if (event.shiftKey && document.activeElement === first) {
          event.preventDefault();
          last.focus();
        } else if (!event.shiftKey && document.activeElement === last) {
          event.preventDefault();
          first.focus();
        }
      }
    });

    mobileQuery.addEventListener('change', () => setOpen(false));

    let ticking = false;

    function updateScrollState() {
      if (ticking) return;
      ticking = true;

      window.requestAnimationFrame(() => {
        header!.classList.toggle('is-scrolled', window.scrollY > 12);
        ticking = false;
      });
    }

    updateScrollState();
    window.addEventListener('scroll', updateScrollState, { passive: true });
  }
</script>
