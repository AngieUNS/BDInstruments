
---
import { getCategory } from '../data/categories';
import type { ProductCardItem } from '../data/products';

interface Props {
  product: ProductCardItem;
  hidden?: boolean;
}

const { product, hidden = false } = Astro.props;
const category = getCategory(product.category);
const href = product.href === undefined ? `/productos/${product.slug}` : product.href;
const CardLink = href ? 'a' : 'div';
---

<article
    class="product-card"
    data-product
    data-category={product.category}
    hidden={hidden}
>
  <CardLink class="product-card-link" href={href || undefined}>
    <div class="product-card-media">
      <img
          src={product.image}
          alt={product.name}
          loading="lazy"
          width="600"
          height="480"
      />

      <span class="product-card-arrow" aria-hidden="true">↗</span>
    </div>

    <div class="product-card-body">
      {category && (
          <p class="product-card-category">{category.name}</p>
      )}

      <h3>{product.name}</h3>
      <p class="product-card-brand">{product.brand}</p>

      {product.summary && <p class="product-card-summary">{product.summary}</p>}

      {href && (
        <span class="product-card-cta">Consultar equipo <span aria-hidden="true">→</span></span>
      )}
    </div>
  </CardLink>
</article>

<style>
  .product-card {
    min-width: 0;
    height: 100%;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: 16px;
    background: var(--surface);
    transition:
        transform 0.25s ease,
        box-shadow 0.25s ease,
        border-color 0.25s ease;
  }

  .product-card:hover {
    transform: translateY(-4px);
    border-color: #b6c9e8;
    box-shadow: 0 12px 28px rgb(12 27 51 / 9%);
  }

  .product-card-link {
    display: flex;
    height: 100%;
    flex-direction: column;
    color: inherit;
    text-decoration: none;
  }

  .product-card-media {
    position: relative;
    display: grid;
    height: 230px;
    place-items: center;
    overflow: hidden;
    margin: 14px 14px 0;
    border-radius: 6px;
    background:
      radial-gradient(220px 150px at 50% 40%, #fff, transparent 75%),
      linear-gradient(160deg, #eaeff9, #cfdaef);
  }

  .product-card-media img {
    display: block;
    width: 100%;
    height: 100%;
    box-sizing: border-box;
    object-fit: contain;
    padding: 28px;
    mix-blend-mode: multiply;
    transition: transform 0.35s ease;
  }

  .product-card:hover .product-card-media img {
    transform: scale(1.04);
  }

  .product-card-placeholder {
    display: grid;
    width: 100%;
    height: 100%;
    place-items: center;
    color: var(--muted);
    font-size: 0.85rem;
  }

  .product-card-arrow {
    position: absolute;
    top: 12px;
    right: 12px;
    display: grid;
    width: 34px;
    height: 34px;
    place-items: center;
    border: 1px solid var(--line);
    border-radius: 50%;
    background: var(--surface);
    color: var(--brand);
    opacity: 0;
    transform: translate(-3px, 3px);
    transition: 0.2s ease;
  }

  .product-card:hover .product-card-arrow {
    opacity: 1;
    transform: translate(0, 0);
  }

  .product-card-body {
    display: flex;
    flex: 1;
    flex-direction: column;
    align-items: flex-start;
    padding: 22px;
  }

  .product-card-category {
    margin: 0 0 10px;
    color: var(--brand-2);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.055em;
    text-transform: uppercase;
  }

  .product-card-body h3 {
    margin: 0;
    color: var(--ink);
    font-size: 1.5rem;
    font-weight: 500;
    line-height: 1.15;
  }

  .product-card-summary {
    margin: 10px 0 20px;
    color: var(--muted);
    font-size: 0.9rem;
    line-height: 1.7;
  }

  .product-card-brand {
    margin: 8px 0 20px;
    color: var(--muted);
    font-size: 0.9rem;
    font-weight: 600;
  }

  .product-card-brand:has(+ .product-card-summary) {
    margin-bottom: 0;
  }

  .product-card-cta {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-top: auto;
    color: var(--brand);
    font-size: 0.875rem;
    font-weight: 700;
  }

  @media (hover: none) {
    .product-card-arrow {
      opacity: 1;
      transform: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .product-card,
    .product-card-media img,
    .product-card-arrow {
      transition: none;
    }
  }
</style>
