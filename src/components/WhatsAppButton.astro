---
import { whatsappHref } from '../data/site';
---

<a
    class="whatsapp"
    href={whatsappHref()}
    target="_blank"
    rel="noopener noreferrer"
    aria-label="Contactar con BD Instruments por WhatsApp"
>
  <svg
      class="whatsapp-icon"
      viewBox="0 0 24 24"
      fill="currentColor"
      aria-hidden="true"
  >
    <path
        d="M20.52 3.48A11.87 11.87 0 0 0 12.08 0C5.5 0 .15 5.35.15 11.93c0 2.1.55 4.16 1.6 5.97L.05 24l6.25-1.64a11.9 11.9 0 0 0 5.78 1.48h.01c6.58 0 11.93-5.35 11.93-11.93a11.85 11.85 0 0 0-3.5-8.43ZM12.09 21.8a9.9 9.9 0 0 1-5.05-1.38l-.36-.21-3.71.97.99-3.62-.24-.37a9.84 9.84 0 0 1-1.51-5.26c0-5.46 4.44-9.9 9.9-9.9a9.84 9.84 0 0 1 7 2.9 9.84 9.84 0 0 1 2.9 7c-.02 5.45-4.46 9.87-9.92 9.87Zm5.43-7.4c-.3-.15-1.76-.87-2.03-.97-.27-.1-.47-.15-.67.15-.2.3-.77.97-.95 1.17-.17.2-.35.22-.65.07-.3-.15-1.25-.46-2.38-1.47-.88-.78-1.48-1.75-1.66-2.05-.17-.3-.02-.46.13-.61.14-.13.3-.35.45-.52.15-.18.2-.3.3-.5.1-.2.05-.37-.03-.52-.08-.15-.67-1.62-.92-2.22-.24-.58-.48-.5-.66-.51h-.57c-.2 0-.52.08-.8.38-.27.3-1.04 1.02-1.04 2.48s1.07 2.87 1.22 3.07c.15.2 2.1 3.2 5.08 4.48.71.3 1.26.48 1.69.61.71.22 1.36.19 1.87.12.57-.08 1.76-.72 2.01-1.42.25-.7.25-1.3.18-1.42-.08-.13-.28-.2-.58-.35Z"
    />
  </svg>

  <span class="whatsapp-label">WhatsApp</span>
  <span class="whatsapp-tooltip">¿Necesitas asesoría?</span>
</a>

<style>
  .whatsapp {
    position: fixed;
    right: 24px;
    bottom: 24px;
    z-index: 90;

    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;

    min-height: 56px;
    padding: 0 22px;

    border: 1px solid rgb(255 255 255 / 22%);
    border-radius: 999px;
    background: #168b55;
    color: #fff;

    box-shadow:
        0 8px 24px rgb(12 27 51 / 16%),
        0 2px 6px rgb(12 27 51 / 8%);

    font-family: var(--sans, 'Public Sans', sans-serif);
    font-size: 0.95rem;
    font-weight: 700;
    line-height: 1;
    text-decoration: none;

    transition:
        background-color 0.2s ease,
        box-shadow 0.2s ease,
        transform 0.2s ease;
  }

  .whatsapp-icon {
    display: block;
    width: 25px;
    height: 25px;
    flex-shrink: 0;
  }

  .whatsapp-label {
    white-space: nowrap;
  }

  .whatsapp-tooltip {
    position: absolute;
    right: 0;
    bottom: calc(100% + 12px);

    width: max-content;
    max-width: calc(100vw - 40px);
    padding: 11px 15px;
    border: 1px solid var(--line, #d8e0ee);
    border-radius: 10px;

    background: var(--surface, #fff);
    color: var(--ink, #0c1b33);
    box-shadow: 0 6px 20px rgb(12 27 51 / 10%);

    font-size: 0.82rem;
    font-weight: 600;
    line-height: 1.4;

    opacity: 0;
    visibility: hidden;
    transform: translateY(5px);
    pointer-events: none;

    transition:
        opacity 0.2s ease,
        transform 0.2s ease,
        visibility 0.2s ease;
  }

  .whatsapp-tooltip::after {
    position: absolute;
    right: 22px;
    bottom: -6px;
    width: 10px;
    height: 10px;

    border-right: 1px solid var(--line, #d8e0ee);
    border-bottom: 1px solid var(--line, #d8e0ee);
    background: var(--surface, #fff);
    content: '';
    transform: rotate(45deg);
  }

  .whatsapp:hover {
    background: #117747;
    box-shadow: 0 12px 28px rgb(12 27 51 / 20%);
    transform: translateY(-3px);
  }

  .whatsapp:hover .whatsapp-tooltip,
  .whatsapp:focus-visible .whatsapp-tooltip {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }

  .whatsapp:focus-visible {
    outline: 3px solid #8ee7b7;
    outline-offset: 4px;
  }

  @media (max-width: 600px) {
    .whatsapp {
      right: 16px;
      bottom: 16px;
      min-height: 52px;
      padding: 0 18px;
      gap: 8px;
    }

    .whatsapp-icon {
      width: 23px;
      height: 23px;
    }

    .whatsapp-tooltip {
      font-size: 0.78rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .whatsapp,
    .whatsapp-tooltip {
      transition: none;
    }

    .whatsapp:hover {
      transform: none;
    }
  }
</style>