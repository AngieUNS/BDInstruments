---
import MainLayout from '../layouts/MainLayout.astro';
---

<MainLayout title="Página no encontrada" description="La página que busca no está en este sitio.">
  <header class="page-hero">
    <div class="wrap">
      <p class="kicker">404</p>
      <h1>Esa página no está en el sitio.</h1>
      <p class="lead">Puede volver al inicio o abrir el catálogo de instrumentos.</p>
      <div class="hero-actions">
        <a class="button" href="/">Ir al inicio</a>
        <a class="button button-line" href="/productos">Ver productos</a>
      </div>
    </div>
  </header>
</MainLayout>
